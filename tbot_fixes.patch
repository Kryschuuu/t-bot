+    // Ermittelt pro Symbol den Index des Buy-Logeintrags, der aktuell noch
+    // offen ist (letzte Aktion fuer dieses Symbol war "buy", noch kein
+    // dazugehoeriger "sell"). Der Bot haelt pro Symbol immer nur EINE
+    // offene Position, daher reicht "letzte Aktion je Symbol" hier aus.
+    function computeOpenBuyIndices(logs) {
+        var openIndexBySymbol = {};
+        logs.forEach(function(log, idx) {
+            if (log.action === "buy") {
+                openIndexBySymbol[log.symbol] = idx;
+            } else if (log.action === "sell") {
+                delete openIndexBySymbol[log.symbol];
+            }
+        });
+        var openIndices = {};
+        Object.keys(openIndexBySymbol).forEach(function(sym) {
+            openIndices[openIndexBySymbol[sym]] = true;
+        });
+        return openIndices;
+    }
+
+    function escapeHtml(str) {
+        var div = document.createElement("div");
+        div.textContent = str;
+        return div.innerHTML;
+    }
+
+    function manualSell(configId, symbol, btn) {
+        if (!confirm("Offene Position " + symbol + " jetzt manuell verkaufen?")) {
+            return;
+        }
+        btn.disabled = true;
+        btn.innerText = "Verkaufe...";
+        fetch("/api/manual_sell/" + configId + "/" + encodeURIComponent(symbol) + "/")
+            .then(response => response.json().then(data => ({ ok: response.ok, data: data })))
+            .then(function(result) {
+                if (!result.ok || result.data.status !== "ok") {
+                    alert("Verkauf fehlgeschlagen: " + (result.data.message || "Unbekannter Fehler"));
+                    btn.disabled = false;
+                    btn.innerText = "Verkaufen";
+                    return;
+                }
+                // Log-Tabelle und Info-Panel sofort aktualisieren - der
+                // Button verschwindet dabei automatisch, da das Symbol
+                // jetzt einen "sell" als letzte Aktion hat.
+                updateTradingLog();
+                updateInfoPanel();
+            })
+            .catch(function(error) {
+                console.error("Fehler beim manuellen Verkauf:", error);
+                alert("Verkauf fehlgeschlagen (Netzwerkfehler).");
+                btn.disabled = false;
+                btn.innerText = "Verkaufen";
+            });
+    }
