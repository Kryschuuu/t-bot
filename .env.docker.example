# Copy to .env before `docker compose up --build`.
SECRET_KEY=replace-with-a-long-local-secret
PASSPHRASE=local-t-bot
PASSPHRASE_GATE_ENABLED=True
AUTOSTART_BOTS=True
POSTGRES_DB=tbot
POSTGRES_USER=tbot
POSTGRES_PASSWORD=replace-with-a-local-db-password
WEB_PORT=8000

# Resource simulation. Set WEB_CPUS=0.10 to emulate Render Free CPU.
WEB_CPUS=0.50
WORKER_CPUS=0.50
POSTGRES_CPUS=0.50
REDIS_CPUS=0.20
SCHEDULER_CPUS=0.20
CELERY_LOG_LEVEL=INFO

# Optionale Speicher-Limits (Container-Mem) und Tuning-Overrides.
# Wenn nicht gesetzt, berechnet hardware-test.sh passende Werte anhand der
# Host-Ressourcen und schreibt sie in das gemeinsam genutzte Volume.
REDIS_MAXMEMORY=48mb
REDIS_MEMORY=96m
POSTGRES_MEMORY=256m
POSTGRES_MAX_CONNECTIONS=40
POSTGRES_SHARED_BUFFERS_MB=32
POSTGRES_EFFECTIVE_CACHE_MB=128
POSTGRES_WORK_MEM_MB=4
